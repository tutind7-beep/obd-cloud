# Скопируйте этот файл в .env (локально) или задайте переменные на хостинге.

# Секретный ключ для подписи токенов (сгенерируйте случайную строку)
SECRET_KEY=

# Ключ нейросети DeepSeek (получить на platform.deepseek.com)
DEEPSEEK_API_KEY=

# Адрес и модель нейросети (менять обычно не нужно)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Порт (на хостинге Render задаётся автоматически)
PORT=8000
